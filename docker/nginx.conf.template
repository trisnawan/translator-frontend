# ---------------------------------------------------------------------------
# Rendered into /etc/nginx/conf.d/default.conf by the nginx image entrypoint.
# Only the PORT environment variable is substituted (NGINX_ENVSUBST_FILTER,
# see Dockerfile); every other $variable below is an nginx variable and is
# left as-is.
# ---------------------------------------------------------------------------

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json
               application/xml image/svg+xml;

    # Angular routes are client-side: unknown paths fall back to index.html.
    # no-store keeps a freshly deployed build from being served stale HTML.
    location / {
        add_header Cache-Control "no-store";
        try_files $uri $uri/ /index.html;
    }

    # Regenerated on every container start from $API_BASE_URL - never cache it.
    location = /assets/env.js {
        add_header Cache-Control "no-store";
    }

    # Template assets keep stable (unhashed) filenames -> short cache only.
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=604800";
    }

    # Angular build output is content-hashed -> safe to cache forever.
    location ~* \.(?:js|css)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
}
